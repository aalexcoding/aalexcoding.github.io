source 'https://rubygems.org'

gem 'github-pages'
gem 'html-proofer'
gem 'nokogiri'

# `rake test` (see Rakefile) builds the site and link-checks it.
gem 'rake'

# Dropped from the stdlib in Ruby 3.0; `jekyll serve` needs it to run locally.
gem 'webrick'

group :jekyll_plugins do
  gem 'jemoji', '~> 0.8'
end
